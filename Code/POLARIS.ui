                 <property name="frameShadow">
                  <enum>QFrame::Shadow::Sunken</enum>
                 </property>
                </widget>
               </item>
               <item>
                <layout class="QHBoxLayout" name="layoutPidBtns">
                 <property name="spacing">
                  <number>6</number>
                 </property>
                 <item>
                  <spacer name="spacerPidBtns">
                   <property name="orientation">
                    <enum>Qt::Orientation::Horizontal</enum>
                   </property>
                   <property name="sizeHint" stdset="0">
                    <size>
                     <width>40</width>
                     <height>20</height>
                    </size>
                   </property>
                  </spacer>
                 </item>
                </layout>
               </item>
              </layout>
             </widget>
            </item>
        <item>
         <widget class="QGroupBox" name="groupPidHelp">
          <property name="title">
           <string>À quoi sert le PID ?</string>
          </property>
          <layout class="QVBoxLayout" name="layPidHelp">
           <item>
            <widget class="QLabel" name="lblPidHelp">
             <property name="textFormat">
              <enum>Qt::RichText</enum>
             </property>
             <property name="wordWrap">
              <bool>true</bool>
             </property>
             <property name="styleSheet">
              <string notr="true">color:#333;</string>
             </property>
             <property name="text">
              <string>&lt;b&gt;Qu'est-ce que le PID ?&lt;/b&gt; Un régulateur &lt;b&gt;PID&lt;/b&gt; est un automate qui compare en permanence une &lt;b&gt;mesure&lt;/b&gt; à une &lt;b&gt;consigne&lt;/b&gt; (la valeur visée) et ajuste tout seul une &lt;b&gt;commande&lt;/b&gt; pour annuler l'écart. Ici, il maintient l'&lt;b&gt;humidité&lt;/b&gt; à la cible en réglant le &lt;b&gt;débit&lt;/b&gt; d'un débitmètre.&lt;br&gt;&lt;br&gt;&lt;b&gt;Les trois actions :&lt;/b&gt; &lt;b&gt;P&lt;/b&gt; (proportionnel) réagit à l'erreur actuelle ; &lt;b&gt;I&lt;/b&gt; (intégral) rattrape l'erreur accumulée pour supprimer l'écart résiduel ; &lt;b&gt;D&lt;/b&gt; (dérivé) anticipe en réagissant à la vitesse de variation pour limiter les oscillations.&lt;br&gt;&lt;br&gt;&lt;b&gt;Réglages par défaut :&lt;/b&gt; Kp = 0,4 ; Ki = 0,002 ; Kd = 0 ; consigne = 50 % ; période = 1 s. Valeurs de départ prudentes, à affiner selon la réactivité observée.&lt;br&gt;&lt;br&gt;&lt;b&gt;Adresse 7&lt;/b&gt; = le débitmètre (RDM) commandé par le PID, à l'adresse 7 sur le bus — c'est la &lt;i&gt;sortie&lt;/i&gt; de la régulation.&lt;br&gt;&lt;b&gt;Voie V3&lt;/b&gt; = la voie analogique qui &lt;i&gt;mesure&lt;/i&gt; l'humidité, utilisée comme &lt;i&gt;entrée&lt;/i&gt; du PID.</string>
             </property>
            </widget>
           </item>
           <item>
            <widget class="QLabel" name="lblPidSchemaCap">
             <property name="styleSheet">
              <string notr="true">font-weight:bold; margin-top:6px;</string>
             </property>
             <property name="text">
              <string>Schéma d'une boucle fermée :</string>
             </property>
            </widget>
           </item>
           <item>
            <widget class="QLabel" name="lblPidSchema">
             <property name="minimumSize">
              <size><width>600</width><height>144</height></size>
             </property>
             <property name="maximumSize">
              <size><width>600</width><height>144</height></size>
             </property>
             <property name="pixmap">
              <pixmap>schema_pid_boucle.png</pixmap>
             </property>
             <property name="scaledContents">
              <bool>true</bool>
             </property>
            </widget>
           </item>
          </layout>
         </widget>
        </item>
        <item>
         <spacer name="spacerTabPID">
          <property name="orientation">
           <enum>Qt::Orientation::Vertical</enum>
          </property>
          <property name="sizeHint" stdset="0">
           <size>
            <width>20</width>
            <height>40</height>
           </size>
          </property>
         </spacer>
        </item>
       </layout>
      </widget>
     </widget>
    </item>
   </layout>
  </widget>
  <widget class="QStatusBar" name="statusbar"/>
 </widget>
